[Unit]
Description=Vault API
After=network-online.target mysqld.service
Wants=network-online.target mysqld.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/vault
StateDirectory=vault
StateDirectoryMode=0700
EnvironmentFile=-/etc/vault/vault.env
ExecStart=/usr/lib/jvm/jre-25/bin/java -jar /opt/vault/vault-api.jar --server.port=8082
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
